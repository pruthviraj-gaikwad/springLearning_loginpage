# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is ignored by Git. Never commit real secrets.

DB_USERNAME=login_user
DB_PASSWORD=change-me

# A random 256-bit key, Base64 encoded. Generate one in PowerShell with:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=change-me-generate-a-random-base64-value
